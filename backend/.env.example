PORT=5000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/kilogram?schema=public"
FRONTEND_URL="http://localhost:3000"

JWT_SECRET="super-secret-key-change-in-production"
JWT_REFRESH_SECRET="super-refresh-secret-key-change-in-production"

# Cloudinary Configs (leave empty or mock to use automatic local placeholders)
CLOUDINARY_CLOUD_NAME="mock"
CLOUDINARY_API_KEY="mock"
CLOUDINARY_API_SECRET="mock"

# SMTP Nodemailer configs (leave empty to log verification OTP codes directly to terminal console)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Gemini API Key (Enter your real Google Gemini key here to make real AI queries)
GEMINI_API_KEY=""

# Resend API Key for Email OTP Authentication (Primary Email Provider)
RESEND_API_KEY=""
